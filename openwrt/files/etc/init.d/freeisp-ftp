#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

. /usr/lib/freeisp/ftp.sh

start_service() {
	local enabled port listen_address passive_min_port passive_max_port passive_address
	config_load freeisp_ftp
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get port main port 21
	config_get listen_address main listen_address 0.0.0.0
	config_get passive_min_port main passive_min_port 50000
	config_get passive_max_port main passive_max_port 50009
	config_get passive_address main passive_address ''
	freeisp_ftp_validate "$port" "$listen_address" "$passive_min_port" "$passive_max_port" "$passive_address" || return 1
	[ -x /usr/sbin/vsftpd ] || { freeisp_ftp_error 'Install the vsftpd package before enabling FTP'; return 1; }
	freeisp_ftp_root_password_ready /etc/shadow || { freeisp_ftp_error 'Set the router root password before enabling FTP'; return 1; }
	freeisp_ftp_prepare || return 1
	freeisp_ftp_render "$port" "$listen_address" "$passive_min_port" "$passive_max_port" "$passive_address" > /var/run/freeisp-ftp/vsftpd.conf.tmp || return 1
	chmod 600 /var/run/freeisp-ftp/vsftpd.conf.tmp || return 1
	mv /var/run/freeisp-ftp/vsftpd.conf.tmp /var/run/freeisp-ftp/vsftpd.conf || return 1
	procd_open_instance main
	procd_set_param command /usr/sbin/vsftpd /var/run/freeisp-ftp/vsftpd.conf
	procd_set_param file /etc/config/freeisp_ftp /etc/shadow
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger freeisp_ftp
}
