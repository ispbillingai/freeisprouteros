#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled port listen_address
    config_load freeisp_api
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    config_get port main port 8728
    config_get listen_address main listen_address 0.0.0.0
    case "$port" in ''|*[!0-9]*) return 1;; esac
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
    procd_open_instance main
    procd_set_param command /usr/bin/freeisp-api --listen-address "$listen_address" --port "$port"
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/config/freeisp_api
    procd_set_param limits core="0 0"
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger freeisp_api
}
