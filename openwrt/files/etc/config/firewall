config defaults
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option synflood_protect '1'

config zone
	option name 'lan'
	list network 'lan'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'ACCEPT'

config zone
	option name 'wan'
	list network 'wan'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

config zone
	option name 'management'
	list network 'management'
	option input 'ACCEPT'
	option output 'ACCEPT'
	option forward 'REJECT'

config forwarding
	option src 'lan'
	option dest 'wan'

config rule
	option name 'Reject-plain-management-from-LAN'
	option src 'lan'
	option proto 'tcp'
	option dest_port '80'
	option target 'REJECT'

config rule
	option name 'Allow-WAN-DHCP'
	option src 'wan'
	option proto 'udp'
	option src_port '67'
	option dest_port '68'
	option family 'ipv4'
	option target 'ACCEPT'
