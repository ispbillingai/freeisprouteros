#!/bin/sh
# Fixed diagnostic entry points for the authenticated FreeISP Command Line.
# Never pass user input to a shell, eval, or a command selected by the caller.
set -eu
fail() { echo 'Invalid Command Line request.' >&2; exit 2; }
[ "$#" -ge 1 ] || fail
action=$1
shift
case "$action" in
    routes4) [ "$#" -eq 0 ] || fail; exec /sbin/ip -4 route show ;;
    routes6) [ "$#" -eq 0 ] || fail; exec /sbin/ip -6 route show ;;
    log) [ "$#" -eq 0 ] || fail; exec /sbin/logread -l 100 ;;
    ping)
        [ "$#" -eq 2 ] || fail
        [ "${#1}" -le 253 ] || fail
        case "$1" in ''|-*|[!a-zA-Z0-9]*|*[!a-zA-Z0-9.:%_-]*) fail ;; esac
        case "$2" in [1-5]) ;; *) fail ;; esac
        exec /bin/ping -c "$2" -W 1 -w 8 "$1"
        ;;
    *) fail ;;
esac
