{
  "luci-app-freeisp-queues": {
    "description": "Manage FreeISP SQM queues and read kernel queue status",
    "read": {
      "uci": [
        "sqm"
      ],
      "file": {
        "/var/run/sqm/available_qdiscs": [
          "list"
        ],
        "/usr/lib/sqm": [
          "list"
        ],
        "/sbin/tc -s -j qdisc show": [
          "exec"
        ]
      },
      "ubus": {
        "file": [
          "list",
          "exec"
        ],
        "luci-rpc": [
          "getNetworkDevices"
        ],
        "uci": [
          "get",
          "changes"
        ]
      }
    },
    "write": {
      "uci": [
        "sqm"
      ],
      "file": {
        "/etc/init.d/sqm enable": [
          "exec"
        ]
      },
      "ubus": {
        "file": [
          "exec"
        ],
        "uci": [
          "add",
          "set",
          "delete",
          "order",
          "apply",
          "confirm",
          "revert"
        ]
      }
    }
  },
  "luci-app-freeisp": {
    "description": "FreeISP Quick Set network configuration",
    "read": {
      "uci": [
        "network",
        "dhcp",
        "firewall",
        "system"
      ],
      "ubus": {
        "network.interface": [
          "dump"
        ],
        "network.device": [
          "status"
        ]
      }
    },
    "write": {
      "uci": [
        "network",
        "dhcp",
        "firewall",
        "system"
      ]
    }
  },
  "luci-app-freeisp-command-line": {
    "description": "FreeISP Command Line diagnostics and router identity",
    "read": {
      "uci": [
        "network",
        "system"
      ],
      "ubus": {
        "system": [
          "board",
          "info"
        ],
        "network.interface": [
          "dump"
        ],
        "luci-rpc": [
          "getNetworkDevices"
        ],
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/bin/freeisp-command-line": [
          "exec"
        ]
      }
    },
    "write": {
      "uci": [
        "system"
      ]
    }
  },
  "luci-app-freeisp-firewall": {
    "description": "FreeISP firewall configuration and read-only runtime status",
    "read": {
      "uci": [
        "firewall"
      ],
      "ubus": {
        "file": [
          "exec"
        ]
      },
      "file": {
        "/usr/bin/freeisp-firewall-status": [
          "exec"
        ]
      }
    },
    "write": {
      "uci": [
        "firewall"
      ]
    }
  },
  "luci-app-freeisp-interfaces": {
    "description": "FreeISP interface and VLAN device configuration",
    "read": {
      "uci": [
        "network"
      ],
      "ubus": {
        "network.interface": [
          "dump"
        ],
        "network.device": [
          "status"
        ],
        "luci-rpc": [
          "getNetworkDevices"
        ]
      }
    },
    "write": {
      "uci": [
        "network"
      ]
    }
  }
}
